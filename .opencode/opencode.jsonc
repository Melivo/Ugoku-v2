{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/oma/oma.ts"
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "C:/Users/phili/.local/bin/serena.exe",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd",
        "--enable-web-dashboard",
        "false",
        "--tool-timeout",
        "10"
      ],
      "environment": {
        "SERENA_LOG_LEVEL": "info",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      },
      "timeout": 10000,
      "enabled": true
    }
  }
}
